# ═══════════════════════════════════════════════════════════════
# Trade System v2 — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════
# Copy this file to `.env` and populate with your credentials:
#   cp .env.example .env
#
# NEVER commit the .env file to version control.
# ═══════════════════════════════════════════════════════════════

# ─── Fyers Broker Configuration (Primary) ─────────────────────
FYERS_CLIENT_ID="YOUR_APP_ID-100"
FYERS_USER_ID="YOUR_FYERS_USER_ID"
FYERS_SECRET_KEY="YOUR_SECRET_KEY"
FYERS_PIN="YOUR_4_DIGIT_PIN"
FYERS_TOTP_SECRET="YOUR_TOTP_BASE32_SECRET"
FYERS_REDIRECT_URI="https://localhost:5000/"
FYERS_ACCESS_TOKEN=""
FYERS_ENABLED="true"
FYERS_PRIORITY="1"

# ─── Dhan Broker Configuration (Backup) ──────────────────────
DHAN_CLIENT_ID=""
DHAN_API_KEY=""
DHAN_ACCESS_TOKEN=""
DHAN_ENABLED="false"
DHAN_PRIORITY="2"

# ─── Broker Selection ────────────────────────────────────────
PRIMARY_BROKER="fyers"
BACKUP_BROKER="dhan"

# ─── Market Symbols ─────────────────────────────────────────
LIVE_SYMBOLS="NSE:NIFTY50-INDEX,NSE:NIFTYBANK-INDEX,BSE:SENSEX-INDEX"
INDEX_SYMBOLS="NSE:NIFTY50-INDEX,NSE:NIFTYBANK-INDEX,BSE:SENSEX-INDEX"

# ─── Telegram Bot Configuration ──────────────────────────────
# Main alert channel
TELEGRAM_BOT_TOKEN="YOUR_TELEGRAM_BOT_TOKEN"
TELEGRAM_CHAT_ID="YOUR_TELEGRAM_CHAT_ID"

# ST Confirmed signals channel (high-confidence only)
ST_CONFIRMED_TELEGRAM_BOT_TOKEN=""
ST_CONFIRMED_TELEGRAM_CHAT_ID=""

# Top Gainer alerts channel
TELEGRAM_TOP_GAINER_TOKEN=""
TELEGRAM_TOP_GAINER_CHAT_ID=""

# Sector alerts channel
TELEGRAM_TOP_SECTOR_TOKEN=""
TELEGRAM_TOP_SECTORS_CHAT_ID=""

# ─── LLM Brain Configuration (AI Agents) ─────────────────────
LLM_PROVIDER="google"
LLM_MODEL="gemini-2.0-flash"
LLM_TIMEOUT="30"
LLM_API_KEY=""
GOOGLE_API_KEY=""
OPENAI_API_KEY=""

# ─── WhatsApp Configuration (Meta Cloud API Fallback) ────────
WHATSAPP_ENABLED="false"
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_TO_NUMBER=""

# ─── Alert Feature Flags ─────────────────────────────────────
# Intraday option buying alerts are DISABLED by default
# (historically unprofitable — enable only for research/paper trading)
ENABLE_INTRADAY_OPTION_ALERTS="false"
TELEGRAM_ENABLE_INTRADAY_OPTION_ALERTS="false"

# ─── Redis (Inter-Agent Event Bus) ───────────────────────────
# Local: redis://localhost:6379/0
# Docker: redis://redis:6379/0 (auto-set by docker-compose)
REDIS_URL="redis://localhost:6379/0"
