# ═══════════════════════════════════════════════════════════
# Trade System v2 — Git Ignore Rules
# ═══════════════════════════════════════════════════════════

# ─── Secrets & Credentials ────────────────────────────────
.env
.env.*
!.env.example
.secrets/

# ─── Python Artifacts ─────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.egg-info/
*.egg
dist/
build/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# ─── Virtual Environments ─────────────────────────────────
.venv/
venv/

# ─── Database Files ───────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ─── Data & Market Data Directories ───────────────────────
/data/
/market_data/
/option_chain_data/

# ─── Logs ─────────────────────────────────────────────────
/logs/
*.log

# ─── CSV Data Files ───────────────────────────────────────
*.csv

# ─── Reports & Generated HTML ─────────────────────────────
/reports/
*.html

# ─── Scratch / Temp ───────────────────────────────────────
/scratch/
temp_test.txt

# ─── OS / Editor ──────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Orphan / Stray Directories ──────────────────────────
/src/data/
/src/logs/
/tests/logs/
/tests/.secrets/

# ─── Fyers SDK Auto-Generated Logs ───────────────────────
fyersDataSocket.log
