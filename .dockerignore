# ═══════════════════════════════════════════════════════════
# Trade System v2 — Docker Ignore Rules
# Keep the image lean: exclude everything not needed at runtime.
# ═══════════════════════════════════════════════════════════

# ─── Version Control ──────────────────────────────────────
.git
.github
.gitignore

# ─── Python Caches ────────────────────────────────────────
__pycache__
*.pyc
*.pyo
.mypy_cache
.pytest_cache
.ruff_cache
*.egg-info

# ─── Secrets — NEVER bake into the image ──────────────────
# (injected at runtime via env_file or Docker secrets)
.env
.env.*
!.env.example
.secrets/
.secrets.enc

# ─── Database Files — mounted as volumes ──────────────────
*.db
*.sqlite
*.sqlite3
data/

# ─── Logs — mounted as volumes ────────────────────────────
logs/
*.log

# ─── IDE / Editor ─────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS Files ─────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Build Artifacts ──────────────────────────────────────
dist/
build/
*.egg
.venv/
venv/

# ─── Test / Dev / Docs ────────────────────────────────────
tests/
scratch/
docs/
reports/
market_data/
bb_backtest_validation.html
temp_test.txt

# ─── Docker Meta (prevent recursive copy) ─────────────────
docker-compose*.yml
Dockerfile
.dockerignore

# ─── Agent Config (not needed in container) ───────────────
.agents/
