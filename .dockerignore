# Version control
.git
.github
.gitignore

# Python caches
__pycache__
*.pyc
*.pyo
.mypy_cache
.pytest_cache
.ruff_cache
*.egg-info

# Secrets — NEVER include in Docker image
.env
.env.*
.secrets/
.secrets.enc

# Database files — mounted as volumes, not baked into image
*.db
data/

# Logs — mounted as volumes
logs/
*.log

# IDE / editor
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Build artifacts
dist/
build/
*.egg

# Test / dev files
tests/
scratch/
docs/
reports/
bb_backtest_validation.html
temp_test.txt
market_data/

# Docker
docker-compose*.yml
Dockerfile
.dockerignore
